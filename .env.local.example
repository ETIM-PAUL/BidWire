# Frontend env (Vite). Copy to .env.local and fill in after `npx convex dev`
# has created a deployment — it prints this value.
VITE_CONVEX_URL=

# Backend env vars are NOT read from .env files. Set them on the Convex
# deployment instead:
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set FIRECRAWL_API_KEY fc-...
#   npx convex env set AGENTMAIL_API_KEY am-...
#   npx convex env set DEMO_MODE true
#   npx convex env set DEMO_ALLOWLIST team1@yourinbox.dev,team2@yourinbox.dev
